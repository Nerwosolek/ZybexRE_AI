        LDA #<%2
        STA %1
        LDA #>%2
        STA %1+1
        .ENDM
        .MACRO WAITCLOCK
        LDA %1
        CLC
        ADC #%2
?WAIT
        CMP %1
        BNE ?WAIT
        .ENDM

