        .MACRO SETPTRXY
        LDX #>%2
        LDY #<%2
        STX %1+1
        STY %1
        .ENDM
        .MACRO SETWORD
        LDA #<%2
        STA %1
        LDA #>%2
        STA %1+1
        .ENDM
        .MACRO COPYWORD
        LDA %2
        STA %1
        LDA %2+1
        STA %1+1
        .ENDM
        .MACRO WAITCLOCK
        LDA %1
        CLC
        ADC #%2
?WAIT
        CMP %1
        BNE ?WAIT
        .ENDM

