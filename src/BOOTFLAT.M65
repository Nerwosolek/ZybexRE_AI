COPYRESOURCES
        LDX #$07 ; $0625
        LDY #$00 ; $0627
        STX COPYSRCH ; $0629
        STY COPYSRC ; $062B
        LDX #$E4 ; $062D
        LDY #$00 ; $062F
        STX COPYDSTH ; $0631
