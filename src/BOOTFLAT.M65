ADR0700          = $0700 ; GLYPHSIMAGE (adres dla makra)
GAMEENTRY        = $0C80
PORTB            = $D301
NMIEN            = $D40E
DSKINV           = $E453
COLDSV           = $E477

        *= $0480
; Naglowek Atari boot: flagi, 25 sektorow, adres $0480, init $0488.
BOOTHEADER
        .BYTE $00,$19 ; $0480
        .WORD BOOTHEADER,BOOTINIT ; $0482
; Procedura fazy boot: CLC/RTS oznacza pomyslne zakonczenie.
BOOTRETURN
        CLC ; $0486
        RTS ; $0487
; Wlasny loader. DCOMND i numer napedu sa odziedziczone po OS.
BOOTINIT
        LDA #$36 ; $0488
        STA COLOR0 ; $048A
        LDA #$00 ; $048D
        STA ATRACT ; $048F
        STA COLOR2 ; $0491
        LDA #$44 ; $0494
        STA SDLSTL ; $0496
        LDA #$05 ; $0499
        STA SDLSTH ; $049B
; Wymaga PORTB=$FF (m.in. BASIC wylaczony); inaczej komunikat OPTION.
        LDA PORTB ; $049E
        CMP #$FF ; $04A1
        BNE WARNBASIC ; $04A3
        LDX #$4F ; $04A5
COPYLOADMSG
        LDA LOADMESSAGE,X ; $04A7
        SEC ; $04AA
        SBC #$20 ; $04AB
        STA BOOTSCREEN,X ; $04AD
        DEX ; $04B0
        BPL COPYLOADMSG ; $04B1
        JMP BOOTCONTINUE ; $04B3
WARNBASIC
        LDX #$27 ; $04B6
COPYWARNMSG
        LDA WARNMESSAGE,X ; $04B8
        SEC ; $04BB
        SBC #$20 ; $04BC
        STA BOOTSCREEN,X ; $04BE
        DEX ; $04C1
        BPL COPYWARNMSG ; $04C2
; Petla bez wyjscia. Uzytkownik ma nacisnac RESET zgodnie z komunikatem.
WAITRESET
        JMP WAITRESET ; $04C4
BOOTCONTINUE
        JSR COPYRESOURCES ; $04C7
        LDA RTCLOKLO ; $04CA
        CLC ; $04CC
        ADC #$02 ; $04CD
WAITBOOTCLOCK
        CMP RTCLOKLO ; $04CF
        BNE WAITBOOTCLOCK ; $04D1
        JSR LOADPAYLOAD ; $04D3
        LDA #$00 ; $04D6
        STA COLDST ; $04D8
        LDA #$01 ; $04DB
        STA BOOTFLAG ; $04DD
        LDA #$80 ; $04DF
        STA DOSINI ; $04E1
        LDA #$0C ; $04E3
        STA DOSINIH ; $04E5
        JMP GAMEENTRY ; $04E7
; Czyta kolejno sektory $0100-$026C (256-620), po 128 bajtow.
LOADPAYLOAD
        LDA #$00 ; $04EA
        STA DBUFLO ; $04EC
        STA DAUX1 ; $04EF
        LDA #$06 ; $04F2
        STA DBUFHI ; $04F4
        LDA #$01 ; $04F7
        STA DAUX2 ; $04F9
; DSKINV jest usluga ROM; dane sa ladowane od $0600.
READSECTOR
        JSR DSKINV ; $04FC
        LDA DAUX2 ; $04FF
        CMP #$02 ; $0502
        BNE NEXTSECTOR ; $0504
        LDA DAUX1 ; $0506
        CMP #$6C ; $0509
        BNE NEXTSECTOR ; $050B
        JMP LOADDONE ; $050D
NEXTSECTOR
        LDA DAUX1 ; $0510
        CMP #$FF ; $0513
        BNE INCSECTORLO ; $0515
        INC DAUX2 ; $0517
INCSECTORLO
        INC DAUX1 ; $051A
        LDA DBUFLO ; $051D
        CMP #$80 ; $0520
        BEQ NEXTBUFPAGE ; $0522
        LDA #$80 ; $0524
        STA DBUFLO ; $0526
        JMP READSECTOR ; $0529
NEXTBUFPAGE
        LDA #$00 ; $052C
        STA DBUFLO ; $052E
        INC DBUFHI ; $0531
        JMP READSECTOR ; $0534
; Fragment kontroli bledu bez odnalezionego poprzednika w glownym CFG.
UNUSEDCHECK
        BMI BOOTERROR ; $0537
LOADDONE
        RTS ; $0539
; Ustawia COLDST i wywoluje zimny restart OS. Sciezka nieosiagalna z loadera.
BOOTERROR
        LDA #$FF ; $053A
        STA COLDST ; $053C
        JSR COLDSV ; $053F
