DOSINI           = $0C
DOSINIH          = $0D
RTCLOKLO         = $14
ATRACT           = $41
COPYSRC          = $92
COPYSRCH         = $93
COPYDST          = $94
COPYDSTH         = $95
SDLSTL           = $0230
SDLSTH           = $0231
COLDST           = $0244
COLOR0           = $02C4
COLOR2           = $02C6
DBUFLO           = $0304
DBUFHI           = $0305
DAUX1            = $030A
DAUX2            = $030B
