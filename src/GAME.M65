; Zachowuje A, X, Y na stosie, dokladnie jak oryginalne 5 instrukcji.
        .MACRO PUSHREGS
        PHA
        TXA
        PHA
        TYA
        PHA
        .ENDM

; Odtwarza Y, X, A; nie zawiera RTI ani RTS.
        .MACRO POPREGS
        PLA
        TAY
        PLA
        TAX
        PLA
        .ENDM

; %1=wskaznik, %2=adres. Laduje X=high/Y=low, zapis high potem low.
        .MACRO SETPTRXY
        LDX #>%2
        LDY #<%2
        STX %1+1
        STY %1
        .ENDM

; %1=komorka slowa, %2=wartosc. Zapis przez A: low potem high.
        .MACRO SETWORD
        LDA #<%2
        STA %1
        LDA #>%2
        STA %1+1
        .ENDM

; %1=cel, %2=zrodlo. Kopia low/high przez A.
        .MACRO COPYWORD
        LDA %2
        STA %1
        LDA %2+1
        STA %1+1
        .ENDM

; %1=licznik, %2=delta. Czeka na dokladna rownosc modulo 256.
        .MACRO WAITCLOCK
        LDA %1
        CLC
        ADC #%2
?WAIT
        CMP %1
        BNE ?WAIT
        .ENDM

; %1=stan glosu, %2=wskaznik ZP obwiedni, %3=rejestr AUDF. 100 bajtow.
        .MACRO SFXSTEP
        LDA %1+5
        BNE ?ACTIVE
        LDA #$00
        STA %3+1
        STA %1+10
        RTS
?ACTIVE
        DEC %1+5
        LDA %1+6
        BEQ ?FREQ
        LDY %1
        LDA (%2),Y
        CMP #$FF
        BNE ?ENVNEW
        LDA #$00
        STA %1+6
        JMP ?FREQ
?ENVNEW
        STA %1+7
        ORA %1+9
        STA %1+1
        INC %1
?FREQ
        LDA %1+2
        STA %1+8
        LSR %1+8
        BCC ?DOWN
        LDA %1+4
        CLC
        ADC %1+3
        STA %1+4
?DOWN
        LSR %1+8
        BCC ?OUTPUT
        LDA %1+4
        SEC
        SBC %1+3
        STA %1+4
?OUTPUT
        LDA %1+1
        STA %3+1
        LDA %1+4
        STA %3
        RTS
        .ENDM

